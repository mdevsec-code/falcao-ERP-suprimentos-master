# .env de produção (VPS da Hostinger). Copie para a RAIZ do projeto como `.env`
# e preencha. Nunca versione o arquivo preenchido.

# PostgreSQL no próprio VPS (criado pelo deploy/setup-vps.sh). Só aceita conexão local.
DATABASE_URL="postgresql://falcao:SENHA_DO_BANCO@localhost:5432/falcao_erp?schema=public"

# API
NODE_ENV=production
PORT=3333
# Gere cada segredo com:  openssl rand -base64 48
JWT_SECRET="TROQUE-por-um-segredo-longo-e-aleatorio"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="TROQUE-por-outro-segredo-longo-e-aleatorio"
JWT_REFRESH_EXPIRES_IN="7d"
# Fora da pasta do código, para não se perder num deploy (e entra no backup).
UPLOADS_DIR="/var/lib/falcao-erp/uploads"
# Domínio do site (o mesmo do Nginx). Mais de um: separe por vírgula.
CORS_ORIGIN="https://suprimentos.seudominio.com.br"
# A API fica atrás do Nginx: 1 proxy.
TRUST_PROXY=1

# Web (usado no build): a API no mesmo domínio, em /api/v1.
VITE_API_URL="https://suprimentos.seudominio.com.br/api/v1"
