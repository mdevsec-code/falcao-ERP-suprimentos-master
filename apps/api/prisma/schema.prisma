generator client {
  provider   = "prisma-client-js"
  // "binary" roda o motor do Prisma como processo separado em vez de
  // carregar um .dll.node dentro do Node — evita um bug comum no Windows
  // onde antivírus/Defender corrompem o carregamento da lib nativa
  // ("... is not a valid Win32 application"). Mesmo ajuste do Saúde Ocupacional.
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Multi-tenancy foundation
// ─────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  suppliers        Supplier[]
  products         Product[]
  purchaseRequests PurchaseRequest[]
  auditLogs        AuditLog[]
  contracts        Contract[]
  payables         Payable[]
  reimbursements   Reimbursement[]
  documents        Document[]
  agendaEvents     AgendaEvent[]
  disciplines      Discipline[]
  approvalSteps    ApprovalStepApprover[]
  quotations       Quotation[]
  requisitionPlans RequisitionPlan[]
  supplierCatalogs SupplierCatalog[]

  /// Link público para fornecedores enviarem catálogo (HMAC do nonce; null = desligado).
  catalogLinkNonce String? @map("catalog_link_nonce")

  @@map("companies")
}

enum Role {
  ADMIN
  MANAGER
  BUYER
  FINANCE
  WAREHOUSE
  REQUESTER
  AUDITOR
}

model User {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          Role     @default(REQUESTER)
  isActive      Boolean  @default(true) @map("is_active")
  /// Assinatura desenhada guardada para reaproveitar nas aprovações (PNG em data URL).
  signatureData String?  @map("signature_data")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshTokens             RefreshToken[]
  approvalSteps             ApprovalStepApprover[]
  purchaseRequestSignatures PurchaseRequestSignature[]
  supplierEvaluations       SupplierEvaluation[]
  uploadedDocuments         SupplierDocument[]
  auditLogs                 AuditLog[]

  requestedPurchaseRequests PurchaseRequest[]           @relation("PurchaseRequestRequester")
  purchaseRequestApprovals  PurchaseRequestApproval[]
  purchaseRequestComments   PurchaseRequestComment[]
  uploadedAttachments       PurchaseRequestAttachment[]

  createdContracts         Contract[]                @relation("ContractCreatedBy")
  contractAmendments       ContractAmendment[]
  createdPayables          Payable[]                 @relation("PayableCreatedBy")
  reimbursements           Reimbursement[]           @relation("ReimbursementRequester")
  decidedReimbursements    Reimbursement[]           @relation("ReimbursementDecidedBy")
  reimbursementAttachments ReimbursementAttachment[]
  uploadedCentralDocuments Document[]
  agendaEvents             AgendaEvent[]
  createdQuotations        Quotation[]               @relation("QuotationCreatedBy")
  createdRequisitionPlans  RequisitionPlan[]         @relation("RequisitionPlanCreatedBy")
  reviewedCatalogs         SupplierCatalog[]         @relation("SupplierCatalogReviewedBy")

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// Suppliers (Fornecedores) — Fase 1 business module
// ─────────────────────────────────────────────────────────────

enum SupplierCategory {
  MATERIAIS_CONSTRUCAO
  EQUIPAMENTOS
  SERVICOS_ENGENHARIA
  MAO_DE_OBRA
  TRANSPORTE_LOGISTICA
  TECNOLOGIA
  CONSULTORIA
  MANUTENCAO
  OUTROS
}

model Supplier {
  id                String           @id @default(uuid())
  companyId         String           @map("company_id")
  razaoSocial       String           @map("razao_social")
  nomeFantasia      String           @map("nome_fantasia")
  cnpj              String
  inscricaoEstadual String?          @map("inscricao_estadual")
  categoria         SupplierCategory
  cidade            String
  estado            String           @db.VarChar(2)
  responsavel       String
  isActive          Boolean          @default(true) @map("is_active")
  /// Cadastrado pelo próprio fornecedor (link aberto de cotação ou de catálogo) e ainda não revisado.
  cadastroPendente  Boolean          @default(false) @map("cadastro_pendente")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts    SupplierContact[]
  evaluations SupplierEvaluation[]
  documents   SupplierDocument[]

  primaryForProducts  Product[]           @relation("PrimarySupplierProducts")
  alternativeProducts ProductSupplier[]
  priceEntries        ProductPriceEntry[]

  contracts        Contract[]
  payables         Payable[]
  centralDocuments Document[]
  agendaEvents     AgendaEvent[]
  quotations       QuotationSupplier[]
  catalogs         SupplierCatalog[]

  @@unique([companyId, cnpj])
  @@index([companyId])
  @@index([companyId, categoria])
  @@index([companyId, estado])
  @@map("suppliers")
}

enum ContactType {
  PHONE
  EMAIL
}

model SupplierContact {
  id         String      @id @default(uuid())
  supplierId String      @map("supplier_id")
  type       ContactType
  label      String
  value      String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_contacts")
}

model SupplierEvaluation {
  id         String   @id @default(uuid())
  supplierId String   @map("supplier_id")
  authorId   String   @map("author_id")
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([supplierId])
  @@map("supplier_evaluations")
}

enum SupplierDocumentCategory {
  CERTIFICADO
  CONTRATO
  COTACAO
  COMPROVANTE
  OUTRO
}

model SupplierDocument {
  id           String                   @id @default(uuid())
  supplierId   String                   @map("supplier_id")
  fileName     String                   @map("file_name")
  filePath     String                   @map("file_path")
  mimeType     String                   @map("mime_type")
  size         Int
  category     SupplierDocumentCategory @default(OUTRO)
  uploadedById String                   @map("uploaded_by_id")
  uploadedAt   DateTime                 @default(now()) @map("uploaded_at")

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([supplierId])
  @@map("supplier_documents")
}

// ─────────────────────────────────────────────────────────────
// Products (Banco de Produtos) — Fase 2 business module
// ─────────────────────────────────────────────────────────────

enum ProductCategory {
  MATERIAIS_CONSTRUCAO
  EQUIPAMENTOS
  FERRAMENTAS
  EPI
  ELETRICA
  HIDRAULICA
  ACABAMENTO
  OUTROS
}

enum UnitOfMeasure {
  UN
  KG
  M
  M2
  M3
  L
  CX
  PC
  SC
  TON
}

model Product {
  id           String          @id @default(uuid())
  companyId    String          @map("company_id")
  codigo       String
  nome         String
  categoria    ProductCategory
  marca        String?
  /// Referência / part number do fabricante.
  referencia   String?
  unidade      UnitOfMeasure
  leadTimeDays Int?            @map("lead_time_days")
  observacoes  String?
  /// Foto do produto (aparece no catálogo, no pedido e no plano de aquisição).
  photoPath    String?         @map("photo_path")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  primarySupplierId String?   @map("primary_supplier_id")
  primarySupplier   Supplier? @relation("PrimarySupplierProducts", fields: [primarySupplierId], references: [id])

  disciplineId String?     @map("discipline_id")
  discipline   Discipline? @relation(fields: [disciplineId], references: [id])

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  alternativeSuppliers ProductSupplier[]
  priceHistory         ProductPriceEntry[]
  purchaseRequestItems PurchaseRequestItem[]
  quotationItems       QuotationItem[]
  catalogItems         SupplierCatalogItem[]

  @@unique([companyId, codigo])
  @@index([companyId])
  @@index([companyId, categoria])
  @@index([companyId, disciplineId])
  @@map("products")
}

model ProductSupplier {
  id         String @id @default(uuid())
  productId  String @map("product_id")
  supplierId String @map("supplier_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([productId])
  @@map("product_suppliers")
}

model ProductPriceEntry {
  id          String           @id @default(uuid())
  productId   String           @map("product_id")
  supplierId  String?          @map("supplier_id")
  price       Decimal          @db.Decimal(12, 2)
  quantity    Decimal?         @db.Decimal(12, 2)
  marca       String?
  referencia  String?
  origem      PriceEntrySource @default(MANUAL)
  quotationId String?          @map("quotation_id")
  catalogId   String?          @map("catalog_id")
  recordedAt  DateTime         @default(now()) @map("recorded_at")

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier  Supplier?        @relation(fields: [supplierId], references: [id])
  quotation Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  catalog   SupplierCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_price_entries")
}

// ─────────────────────────────────────────────────────────────
// Purchase Requests (Solicitações de Compras & Aprovações) — Fase 3
// ─────────────────────────────────────────────────────────────

enum PurchaseRequestStatus {
  AGUARDANDO_APROVACAO
  EM_COMPRAS
  EM_COTACAO
  PEDIDO_REALIZADO
  AGUARDANDO_RECEBIMENTO
  FINALIZADO
  REJEITADO
}

enum ApprovalAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
}

model PurchaseRequest {
  id               String                @id @default(uuid())
  companyId        String                @map("company_id")
  /// Número sequencial por empresa — o nº impresso no plano de aquisição.
  numero           Int
  requesterId      String                @map("requester_id")
  title            String
  justification    String?               @map("justification")
  /// Nome do projeto / obra / centro de custo.
  costCenter       String?               @map("cost_center")
  /// Telefone ou ramal de quem pediu (o "contato do solicitante" do formulário).
  requesterContact String?               @map("requester_contact")
  status           PurchaseRequestStatus @default(AGUARDANDO_APROVACAO)
  /// Etapa de assinatura em que o pedido está (só enquanto aguarda aprovação).
  currentStep      ApprovalStep?         @map("current_step")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester User    @relation("PurchaseRequestRequester", fields: [requesterId], references: [id])

  items       PurchaseRequestItem[]
  approvals   PurchaseRequestApproval[]
  comments    PurchaseRequestComment[]
  attachments PurchaseRequestAttachment[]
  signatures  PurchaseRequestSignature[]

  payables     Payable[]
  agendaEvents AgendaEvent[]
  quotations   Quotation[]
  planEntries  RequisitionPlanRequest[]

  @@unique([companyId, numero])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, requesterId])
  @@index([companyId, currentStep])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String    @id @default(uuid())
  purchaseRequestId String    @map("purchase_request_id")
  productId         String?   @map("product_id")
  description       String
  quantity          Decimal   @db.Decimal(12, 2)
  unit              String
  estimatedPrice    Decimal?  @map("estimated_price") @db.Decimal(12, 2)
  marca             String?
  referencia        String?
  /// Especificação técnica pedida (norma, cor, tamanho, modelo…).
  especificacao     String?
  /// Peso total do item, em kg (opcional — ajuda no frete).
  pesoTotal         Decimal?  @map("peso_total") @db.Decimal(12, 3)
  /// Onde o material vai ser usado (frente de obra, equipe).
  localUso          String?   @map("local_uso")
  /// Setor que pediu o item (ex.: Engenharia de segurança).
  setorSolicitante  String?   @map("setor_solicitante")
  /// Data em que o material precisa chegar.
  dataNecessaria    DateTime? @map("data_necessaria") @db.Date
  /// Foto do item (pasta item-photos/<empresa>/…); sem ela vale a foto do produto.
  photoPath         String?   @map("photo_path")

  purchaseRequest PurchaseRequest       @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product         Product?              @relation(fields: [productId], references: [id])
  quotationItems  QuotationItem[]
  planOrigins     QuotationItemOrigin[]

  @@index([purchaseRequestId])
  @@map("purchase_request_items")
}

/// Etapas de assinatura do plano de aquisição, nesta ordem.
enum ApprovalStep {
  TECNICO
  COMPRAS
  CUSTOS
  GERENTE_GERAL
}

enum SignatureDecision {
  APROVADO
  RECUSADO
}

/// Quem assina cada etapa (configurado pelo administrador). Qualquer um da etapa pode assinar.
model ApprovalStepApprover {
  id        String       @id @default(uuid())
  companyId String       @map("company_id")
  step      ApprovalStep
  userId    String       @map("user_id")
  createdAt DateTime     @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, step, userId])
  @@index([companyId, step])
  @@map("approval_step_approvers")
}

/// Assinatura digital de uma etapa: imagem desenhada + quem, quando e de onde.
model PurchaseRequestSignature {
  id                String            @id @default(uuid())
  purchaseRequestId String            @map("purchase_request_id")
  step              ApprovalStep
  decision          SignatureDecision
  userId            String            @map("user_id")
  /// Nome de quem assinou na hora (fica no documento mesmo se o usuário mudar de nome).
  signerName        String            @map("signer_name")
  /// PNG da assinatura desenhada, em data URL.
  signatureData     String            @map("signature_data")
  comment           String?
  ip                String?
  userAgent         String?           @map("user_agent")
  signedAt          DateTime          @default(now()) @map("signed_at")

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@unique([purchaseRequestId, step])
  @@index([purchaseRequestId])
  @@map("purchase_request_signatures")
}

model PurchaseRequestApproval {
  id                String                @id @default(uuid())
  purchaseRequestId String                @map("purchase_request_id")
  approverId        String                @map("approver_id")
  action            ApprovalAction
  fromStatus        PurchaseRequestStatus @map("from_status")
  toStatus          PurchaseRequestStatus @map("to_status")
  comment           String?
  createdAt         DateTime              @default(now()) @map("created_at")

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  approver        User            @relation(fields: [approverId], references: [id])

  @@index([purchaseRequestId])
  @@map("purchase_request_approvals")
}

model PurchaseRequestComment {
  id                String   @id @default(uuid())
  purchaseRequestId String   @map("purchase_request_id")
  authorId          String   @map("author_id")
  message           String
  createdAt         DateTime @default(now()) @map("created_at")

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  author          User            @relation(fields: [authorId], references: [id])

  @@index([purchaseRequestId])
  @@map("purchase_request_comments")
}

model PurchaseRequestAttachment {
  id                String   @id @default(uuid())
  purchaseRequestId String   @map("purchase_request_id")
  fileName          String   @map("file_name")
  filePath          String   @map("file_path")
  mimeType          String   @map("mime_type")
  size              Int
  uploadedById      String   @map("uploaded_by_id")
  uploadedAt        DateTime @default(now()) @map("uploaded_at")

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  uploadedBy      User            @relation(fields: [uploadedById], references: [id])

  @@index([purchaseRequestId])
  @@map("purchase_request_attachments")
}

// ─────────────────────────────────────────────────────────────
// Contracts (Contratos) — Fase 4
// ─────────────────────────────────────────────────────────────

enum ContractStatus {
  VIGENTE
  SUSPENSO
  ENCERRADO
  CANCELADO
}

model Contract {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  supplierId  String         @map("supplier_id")
  numero      String
  objeto      String
  descricao   String?
  costCenter  String?        @map("cost_center")
  valorTotal  Decimal        @map("valor_total") @db.Decimal(14, 2)
  dataInicio  DateTime       @map("data_inicio") @db.Date
  dataFim     DateTime       @map("data_fim") @db.Date
  assinadoEm  DateTime?      @map("assinado_em") @db.Date
  alertaDias  Int            @default(30) @map("alerta_dias")
  status      ContractStatus @default(VIGENTE)
  createdById String         @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  createdBy  User                @relation("ContractCreatedBy", fields: [createdById], references: [id])
  amendments ContractAmendment[]
  documents  Document[]
  payables   Payable[]

  @@unique([companyId, numero])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dataFim])
  @@map("contracts")
}

/// Aditivo: altera valor e/ou prazo do contrato e fica registrado no histórico.
model ContractAmendment {
  id          String    @id @default(uuid())
  contractId  String    @map("contract_id")
  numero      Int
  descricao   String
  valorDelta  Decimal?  @map("valor_delta") @db.Decimal(14, 2)
  novaDataFim DateTime? @map("nova_data_fim") @db.Date
  authorId    String    @map("author_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@unique([contractId, numero])
  @@index([contractId])
  @@map("contract_amendments")
}

// ─────────────────────────────────────────────────────────────
// Finance (Contas a pagar) — Fase 5
// ─────────────────────────────────────────────────────────────

enum PayableStatus {
  ABERTO
  PAGO
  CANCELADO
}

enum PayableSource {
  MANUAL
  PEDIDO
  CONTRATO
  REEMBOLSO
}

enum PaymentMethod {
  BOLETO
  PIX
  TRANSFERENCIA
  CARTAO
  DINHEIRO
}

model Payable {
  id                String         @id @default(uuid())
  companyId         String         @map("company_id")
  descricao         String
  origem            PayableSource  @default(MANUAL)
  supplierId        String?        @map("supplier_id")
  contractId        String?        @map("contract_id")
  purchaseRequestId String?        @map("purchase_request_id")
  reimbursementId   String?        @unique @map("reimbursement_id")
  costCenter        String?        @map("cost_center")
  valor             Decimal        @db.Decimal(14, 2)
  vencimento        DateTime       @db.Date
  status            PayableStatus  @default(ABERTO)
  notaFiscal        String?        @map("nota_fiscal")
  notaFiscalEmissao DateTime?      @map("nota_fiscal_emissao") @db.Date
  /// Chave de acesso da NF-e (44 dígitos), lida do XML.
  notaFiscalChave   String?        @map("nota_fiscal_chave")
  notaFiscalPdfPath String?        @map("nota_fiscal_pdf_path")
  notaFiscalPdfName String?        @map("nota_fiscal_pdf_name")
  notaFiscalXmlPath String?        @map("nota_fiscal_xml_path")
  notaFiscalXmlName String?        @map("nota_fiscal_xml_name")
  pagoEm            DateTime?      @map("pago_em") @db.Date
  valorPago         Decimal?       @map("valor_pago") @db.Decimal(14, 2)
  formaPagamento    PaymentMethod? @map("forma_pagamento")
  observacoes       String?
  createdById       String         @map("created_by_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  contract        Contract?        @relation(fields: [contractId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  reimbursement   Reimbursement?   @relation(fields: [reimbursementId], references: [id])
  createdBy       User             @relation("PayableCreatedBy", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, vencimento])
  @@map("payables")
}

// ─────────────────────────────────────────────────────────────
// Reimbursements (Reembolsos) — Fase 6
// ─────────────────────────────────────────────────────────────

enum ReimbursementStatus {
  ENVIADO
  APROVADO
  REJEITADO
  PAGO
}

enum ExpenseCategory {
  TRANSPORTE
  COMBUSTIVEL
  ALIMENTACAO
  HOSPEDAGEM
  MATERIAL
  OUTROS
}

model Reimbursement {
  id              String              @id @default(uuid())
  companyId       String              @map("company_id")
  requesterId     String              @map("requester_id")
  titulo          String
  costCenter      String?             @map("cost_center")
  status          ReimbursementStatus @default(ENVIADO)
  decidedById     String?             @map("decided_by_id")
  decidedAt       DateTime?           @map("decided_at")
  decisionComment String?             @map("decision_comment")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester   User                      @relation("ReimbursementRequester", fields: [requesterId], references: [id])
  decidedBy   User?                     @relation("ReimbursementDecidedBy", fields: [decidedById], references: [id])
  items       ReimbursementItem[]
  attachments ReimbursementAttachment[]
  payable     Payable?

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, requesterId])
  @@map("reimbursements")
}

model ReimbursementItem {
  id              String          @id @default(uuid())
  reimbursementId String          @map("reimbursement_id")
  data            DateTime        @db.Date
  categoria       ExpenseCategory
  descricao       String
  valor           Decimal         @db.Decimal(12, 2)

  reimbursement Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@index([reimbursementId])
  @@map("reimbursement_items")
}

model ReimbursementAttachment {
  id              String   @id @default(uuid())
  reimbursementId String   @map("reimbursement_id")
  fileName        String   @map("file_name")
  filePath        String   @map("file_path")
  mimeType        String   @map("mime_type")
  size            Int
  uploadedById    String   @map("uploaded_by_id")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  reimbursement Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])

  @@index([reimbursementId])
  @@map("reimbursement_attachments")
}

// ─────────────────────────────────────────────────────────────
// Documents (repositório central) — Fase 7
// ─────────────────────────────────────────────────────────────

enum DocumentCategory {
  CONTRATO
  NOTA_FISCAL
  CERTIDAO
  LICENCA
  APOLICE
  PROJETO
  MANUAL
  POLITICA
  OUTRO
}

model Document {
  id           String           @id @default(uuid())
  companyId    String           @map("company_id")
  titulo       String
  descricao    String?
  categoria    DocumentCategory @default(OUTRO)
  /// Sempre em minúsculas — o filtro por etiqueta é exato.
  tags         String[]
  validoAte    DateTime?        @map("valido_ate") @db.Date
  /// Texto extraído de arquivos de texto (txt, csv, md, json, xml, log) para a busca por conteúdo.
  conteudo     String?
  fileName     String           @map("file_name")
  filePath     String           @map("file_path")
  mimeType     String           @map("mime_type")
  size         Int
  supplierId   String?          @map("supplier_id")
  contractId   String?          @map("contract_id")
  uploadedById String           @map("uploaded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  contract   Contract? @relation(fields: [contractId], references: [id])
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([companyId])
  @@index([companyId, categoria])
  @@index([companyId, validoAte])
  @@index([contractId])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────
// Agenda — Fase 8
// ─────────────────────────────────────────────────────────────

enum AgendaEventType {
  ENTREGA
  RECEBIMENTO
  VISITA
  REUNIAO
  LEMBRETE
  OUTRO
}

model AgendaEvent {
  id                String          @id @default(uuid())
  companyId         String          @map("company_id")
  titulo            String
  descricao         String?
  tipo              AgendaEventType
  inicio            DateTime
  fim               DateTime?
  diaInteiro        Boolean         @default(false) @map("dia_inteiro")
  /// Obra / centro de custo — a "visão por obra" filtra por aqui.
  obra              String?
  local             String?
  supplierId        String?         @map("supplier_id")
  purchaseRequestId String?         @map("purchase_request_id")
  createdById       String          @map("created_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([companyId, inicio])
  @@map("agenda_events")
}

// ─────────────────────────────────────────────────────────────
// Cross-cutting: audit trail (reused by every future module)
// ─────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(uuid())
  companyId  String      @map("company_id")
  userId     String      @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  changes    Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Disciplinas (Civil, Elétrica, Eletromecânica…) — lista editável por empresa
// ─────────────────────────────────────────────────────────────

model Discipline {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  nome      String
  ordem     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, nome])
  @@index([companyId])
  @@map("disciplines")
}

enum PriceEntrySource {
  MANUAL
  COTACAO
  CATALOGO
}

// ─────────────────────────────────────────────────────────────
// Cotações — mapa de preços de vários fornecedores para uma solicitação
// ─────────────────────────────────────────────────────────────

enum QuotationStatus {
  ABERTA
  ENCERRADA
  CANCELADA
}

enum QuotationSupplierStatus {
  CONVIDADO
  RESPONDIDO
  RECUSOU
}

/// Como o fornecedor entrou na cotação: convidado por compras ou pelo link aberto.
enum QuotationSupplierOrigin {
  CONVITE
  LINK_ABERTO
}

model Quotation {
  id                String          @id @default(uuid())
  companyId         String          @map("company_id")
  /// Cotação de uma solicitação; a cotação de um plano usa `planId` e deixa isto vazio.
  purchaseRequestId String?         @map("purchase_request_id")
  planId            String?         @unique @map("plan_id")
  numero            Int
  titulo            String
  status            QuotationStatus @default(ABERTA)
  prazoResposta     DateTime        @map("prazo_resposta") @db.Date
  observacoes       String?
  createdById       String          @map("created_by_id")
  encerradaEm       DateTime?       @map("encerrada_em")
  /// Link aberto: qualquer fornecedor entra informando o CNPJ (HMAC do nonce; null = desligado).
  linkAbertoNonce   String?         @map("link_aberto_nonce")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  plan            RequisitionPlan?    @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  items           QuotationItem[]
  suppliers       QuotationSupplier[]
  priceEntries    ProductPriceEntry[]

  @@unique([companyId, numero])
  @@index([companyId])
  @@index([companyId, status])
  @@index([purchaseRequestId])
  @@map("quotations")
}

model QuotationItem {
  id                    String  @id @default(uuid())
  quotationId           String  @map("quotation_id")
  purchaseRequestItemId String? @map("purchase_request_item_id")
  productId             String? @map("product_id")
  ordem                 Int     @default(0)
  descricao             String
  quantidade            Decimal @db.Decimal(12, 2)
  unidade               String
  marca                 String?
  referencia            String?
  /// Fornecedor escolhido para este item (null = ainda não decidido).
  vencedorId            String? @map("vencedor_id")

  quotation           Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  purchaseRequestItem PurchaseRequestItem?  @relation(fields: [purchaseRequestItemId], references: [id], onDelete: SetNull)
  product             Product?              @relation(fields: [productId], references: [id])
  vencedor            QuotationSupplier?    @relation("QuotationItemWinner", fields: [vencedorId], references: [id], onDelete: SetNull)
  prices              QuotationPrice[]
  /// Itens de solicitações somados neste item (cotação de plano).
  origens             QuotationItemOrigin[]

  @@index([quotationId])
  @@map("quotation_items")
}

model QuotationSupplier {
  id                String                  @id @default(uuid())
  quotationId       String                  @map("quotation_id")
  supplierId        String                  @map("supplier_id")
  status            QuotationSupplierStatus @default(CONVIDADO)
  origem            QuotationSupplierOrigin @default(CONVITE)
  /// Trocar o nonce invalida o link enviado ao fornecedor (o link é um HMAC dele).
  linkNonce         String                  @map("link_nonce")
  respondidoEm      DateTime?               @map("respondido_em")
  respondidoPor     String?                 @map("respondido_por")
  prazoEntregaDias  Int?                    @map("prazo_entrega_dias")
  condicaoPagamento String?                 @map("condicao_pagamento")
  validadeProposta  DateTime?               @map("validade_proposta") @db.Date
  frete             Decimal?                @db.Decimal(12, 2)
  observacoes       String?
  createdAt         DateTime                @default(now()) @map("created_at")

  quotation Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplier  Supplier         @relation(fields: [supplierId], references: [id])
  prices    QuotationPrice[]
  wonItems  QuotationItem[]  @relation("QuotationItemWinner")

  @@unique([quotationId, supplierId])
  @@index([quotationId])
  @@map("quotation_suppliers")
}

model QuotationPrice {
  id                  String   @id @default(uuid())
  quotationSupplierId String   @map("quotation_supplier_id")
  quotationItemId     String   @map("quotation_item_id")
  precoUnitario       Decimal? @map("preco_unitario") @db.Decimal(12, 2)
  marca               String?
  referencia          String?
  disponivel          Boolean  @default(true)
  observacao          String?
  updatedAt           DateTime @updatedAt @map("updated_at")

  quotationSupplier QuotationSupplier @relation(fields: [quotationSupplierId], references: [id], onDelete: Cascade)
  quotationItem     QuotationItem     @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  @@unique([quotationSupplierId, quotationItemId])
  @@index([quotationItemId])
  @@map("quotation_prices")
}

/// Item de solicitação somado num item consolidado da cotação de um plano.
model QuotationItemOrigin {
  id                    String  @id @default(uuid())
  quotationItemId       String  @map("quotation_item_id")
  purchaseRequestItemId String  @map("purchase_request_item_id")
  quantidade            Decimal @db.Decimal(12, 2)

  quotationItem       QuotationItem       @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)
  purchaseRequestItem PurchaseRequestItem @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Cascade)

  @@unique([quotationItemId, purchaseRequestItemId])
  @@index([purchaseRequestItemId])
  @@map("quotation_item_origins")
}

// ─────────────────────────────────────────────────────────────
// Plano de requisição — junta solicitações aprovadas numa lista só para cotação
// ─────────────────────────────────────────────────────────────

enum RequisitionPlanStatus {
  RASCUNHO
  LANCADO
  CANCELADO
}

model RequisitionPlan {
  id            String                @id @default(uuid())
  companyId     String                @map("company_id")
  numero        Int
  titulo        String
  /// Obra / centro de custo do plano.
  obra          String?
  prazoResposta DateTime              @map("prazo_resposta") @db.Date
  observacoes   String?
  status        RequisitionPlanStatus @default(RASCUNHO)
  createdById   String                @map("created_by_id")
  lancadoEm     DateTime?             @map("lancado_em")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  company   Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User                     @relation("RequisitionPlanCreatedBy", fields: [createdById], references: [id])
  requests  RequisitionPlanRequest[]
  quotation Quotation?

  @@unique([companyId, numero])
  @@index([companyId])
  @@index([companyId, status])
  @@map("requisition_plans")
}

model RequisitionPlanRequest {
  planId            String @map("plan_id")
  purchaseRequestId String @map("purchase_request_id")

  plan            RequisitionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@id([planId, purchaseRequestId])
  @@index([purchaseRequestId])
  @@map("requisition_plan_requests")
}

// ─────────────────────────────────────────────────────────────
// Catálogos enviados por fornecedores — só entram no catálogo vivo após revisão
// ─────────────────────────────────────────────────────────────

enum SupplierCatalogStatus {
  PENDENTE
  REVISADO
  REJEITADO
}

enum SupplierCatalogItemStatus {
  PENDENTE
  IMPORTADO
  IGNORADO
}

model SupplierCatalog {
  id            String                @id @default(uuid())
  companyId     String                @map("company_id")
  supplierId    String                @map("supplier_id")
  status        SupplierCatalogStatus @default(PENDENTE)
  enviadoPor    String                @map("enviado_por")
  observacoes   String?
  /// Arquivo do catálogo (PDF, planilha…) — opcional quando só vieram os itens da planilha modelo.
  fileName      String?               @map("file_name")
  filePath      String?               @map("file_path")
  mimeType      String?               @map("mime_type")
  size          Int?
  revisadoPorId String?               @map("revisado_por_id")
  revisadoEm    DateTime?             @map("revisado_em")
  motivoRecusa  String?               @map("motivo_recusa")
  createdAt     DateTime              @default(now()) @map("created_at")

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier     Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  revisadoPor  User?                 @relation("SupplierCatalogReviewedBy", fields: [revisadoPorId], references: [id])
  items        SupplierCatalogItem[]
  priceEntries ProductPriceEntry[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([supplierId])
  @@map("supplier_catalogs")
}

model SupplierCatalogItem {
  id               String                    @id @default(uuid())
  catalogId        String                    @map("catalog_id")
  ordem            Int                       @default(0)
  codigoFornecedor String?                   @map("codigo_fornecedor")
  descricao        String
  unidade          String
  marca            String?
  referencia       String?
  preco            Decimal?                  @db.Decimal(12, 2)
  observacao       String?
  status           SupplierCatalogItemStatus @default(PENDENTE)
  /// Produto do catálogo vivo ao qual o item foi vinculado na revisão.
  productId        String?                   @map("product_id")

  catalog SupplierCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([catalogId])
  @@map("supplier_catalog_items")
}
