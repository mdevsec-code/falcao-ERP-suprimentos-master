# Postgres (docker-compose)
DATABASE_URL="postgresql://falcao:falcao@localhost:5432/falcao_erp?schema=public"
# Produção (VPS da Hostinger): veja deploy/env.production.example

# API
PORT=3333
JWT_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"
UPLOADS_DIR="./uploads"
CORS_ORIGIN="http://localhost:5173"
# Em produção: domínio(s) do Web separados por vírgula, ex. "https://suprimentos.falcao.com.br,https://www.suprimentos.falcao.com.br"
# Proxies na frente da API (Nginx da Hostinger, ALB da AWS). 0 = acesso direto.
TRUST_PROXY=0

# E-mails de aprovação: deixe SMTP_HOST vazio em desenvolvimento (só registra no log).
APP_URL="http://localhost:5173"
SMTP_HOST=""

# Web
VITE_API_URL="http://localhost:3333/api/v1"
