{
  "name": "falcao-erp",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,yellow \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared-types && npm run build -w apps/api && npm run build -w apps/web",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web",
    "typecheck": "npm run build -w packages/shared-types && npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test": "npm run test -w apps/api && npm run test -w apps/web",
    "format": "npm run format -w apps/web",
    "format:check": "npm run format:check -w apps/web",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "db:studio": "npm run prisma:studio -w apps/api",
    "prepare": "husky",
    "coverage": "npm run coverage -w apps/web"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "concurrently": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true
  },
  "overrides": {
    "multer": "^2.4.0",
    "body-parser": "~1.20.8",
    "lodash": "^4.18.1",
    "qs": "^6.16.0"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/web/**/*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
